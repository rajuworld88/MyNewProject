<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId" access="global" >
    
      <aura:attribute name="message" type="String" default="Hello, this is a message from Salesforce!" />
    
    <lightning:card title="Send WhatsApp Message" iconName="standard:message">
        <aura:set attribute="actions">
            <lightning:button label="Send to WhatsApp" onclick="{!c.sendToWhatsApp}" />
        </aura:set>
        
        <div class="slds-p-horizontal_medium">
            <lightning:textarea name="message" label="Message" value="{!v.message}" rows="4" />
        </div>
    </lightning:card>
    
	
</aura:component>